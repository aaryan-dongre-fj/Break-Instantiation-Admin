# Required. `npm run apply-instance` generates the local secret values.
SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Leave NEXTAUTH_URL unset. Each company uses the browser host.

# Django. A company host such as break.localhost keeps this protocol and port
# and swaps in that hostname. Every other host calls this URL as written.
API_BASE_URL=http://127.0.0.1:8000

# Optional. Lets one API host serve every company: each call names this site's
# host in X-Company-Host. Same value as DJANGO_COMPANY_HOST_SECRET on the API.
# Leave unset locally, where company.localhost hosts already pick the company.
# COMPANY_HOST_SECRET=

# Origin sent with API calls. The backend must list it in CSRF_TRUSTED_ORIGINS.
# Invite and magic-link mail use the company's client_site_url, not this value.
CLIENT_PORTAL_ORIGIN=http://localhost:3001
